# Template for local release signing configuration.
# Copy this file to keystore.properties (gitignored) and fill in your actual values.
#
# Generate a new release keystore with:
# keytool -genkeypair -v -keystore release.keystore -alias localsampark -keyalg RSA -keysize 4096 -validity 10000

MYAPP_UPLOAD_STORE_FILE=release.keystore
MYAPP_UPLOAD_KEY_ALIAS=localsampark
MYAPP_UPLOAD_STORE_PASSWORD=CHANGE_ME_IN_LOCAL_KEYSTORE_PROPERTIES
MYAPP_UPLOAD_KEY_PASSWORD=CHANGE_ME_IN_LOCAL_KEYSTORE_PROPERTIES
