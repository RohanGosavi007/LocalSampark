<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for LocalSampark Android App.
  - Production: strictly HTTPS to the live Render backend.
  - Debug: also permits cleartext HTTP to localhost / emulator host for local dev.
-->
<network-security-config>
    <!-- Base config: block cleartext in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production API server — HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">localsampark-api.onrender.com</domain>
        <domain includeSubdomains="true">localsampark.in</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug-only: allow cleartext to localhost and emulator host -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Allow cleartext for local dev server IPs (Metro bundler) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.7</domain>
    </domain-config>
</network-security-config>
