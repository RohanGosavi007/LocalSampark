  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test:e2e:build": "detox build -c android.emu.debug",
    "test:e2e:test": "detox test -c android.emu.debug",
    "postinstall": "node scripts/postinstall.js && patch-package",
    "bundle:android": "npx expo export:embed --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
