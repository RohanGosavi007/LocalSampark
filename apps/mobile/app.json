{
  "expo": {
    "name": "LocalSampark",
    "slug": "localsampark-mobile",
    "version": "1.0.0",
    "scheme": "localsampark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "android": {
      "package": "in.localsampark.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "localsampark.in"
            },
            {
              "scheme": "https",
              "host": "www.localsampark.in"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "in.localsampark.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "LocalSampark uses the camera to scan QR codes and to photograph products, delivery proof and documents you choose to upload.",
        "NSPhotoLibraryUsageDescription": "LocalSampark needs access to your photos so you can attach product images, review photos and documents.",
        "NSMicrophoneUsageDescription": "LocalSampark uses the microphone for voice search and gate intercom calls.",
        "NSLocationWhenInUseUsageDescription": "LocalSampark uses your location to show nearby shops, check delivery availability and track your order."
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LocalSampark to use your location to find nearby shops and services."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LocalSampark to use the camera to scan QR codes and upload photos.",
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native",
      "./plugins/withTrimmedPermissions",
      "expo-web-browser"
    ],
    "extra": {
      "API_URL_PROD": "https://localsampark-api.onrender.com/api/v1",
      "SUPABASE_URL": "https://qahlydtjfypxhumixtwo.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFhaGx5ZHRqZnlweGh1bWl4dHdvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMyMzU3ODksImV4cCI6MjA5ODgxMTc4OX0.evlCQSJYWBxLub9aGBbneP6JHVxJg-zZx8th0TbByio",
      "router": {},
      "eas": {
        "projectId": "44fa4239-afc4-4135-bfca-22dd924e16c6"
      }
    },
    "owner": "local-sampark"
  }
}
