# LocalSampark Mobile App Environment Variables

# Uncomment and set your Ngrok URL here for physical device testing
# EXPO_PUBLIC_API_URL=https://<your-ngrok-id>.ngrok-free.app/api/v1

# Crash reporting (optional). Unset = disabled.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Supabase Realtime (anon key only — it ships inside the app binary).
# For release builds set these as EAS environment variables instead of a file.
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in client IDs (public identifiers, but set per environment).
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Production builds do NOT read a .env.production file (it is git-ignored on
# purpose). EXPO_PUBLIC_API_URL comes from the "production" profile in eas.json;
# every other EXPO_PUBLIC_* value above is set as an EAS environment variable
# (`eas env:create --environment production`).
