# Web Application Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Firebase Web Config (For Free SMS OTP Login)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Public site origin, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the dedicated admin console (apps/admin) runs. /admin-dashboard in this
# app redirects there. Production: https://admin.<your-domain>
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Supabase (Realtime only). ANON key only — the service-role key must never be
# set in this app: every NEXT_PUBLIC_* value ships in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional
NEXT_PUBLIC_SENTRY_DSN=
# Razorpay *key id* (public). The key secret lives only in the backend env.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Map tiles (public token, URL-restricted in the Mapbox dashboard).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
