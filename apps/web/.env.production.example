# FRONTEND PRODUCTION ENVIRONMENT TEMPLATE (DO NOT COMMIT SECRETS)
NODE_ENV=production

# API URL
NEXT_PUBLIC_API_URL=https://api.localsampark.in

# Web URL
NEXT_PUBLIC_SITE_URL=https://localsampark.in

# Sentry
NEXT_PUBLIC_SENTRY_DSN=YOUR_FRONTEND_SENTRY_DSN

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_LIVE_KEY

# Dedicated admin console origin; /admin-dashboard redirects here.
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
# Supabase Realtime (anon key only; never the service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
