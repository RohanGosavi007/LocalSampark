generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// User & Authentication
// ---------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String    @unique
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  addresses     Address[]
  orders        Order[]
  cartItems     CartItem[]
  shop          Shop?     @relation(fields: [shopId], references: [id])
  shopId        String?
  wallet        Wallet?

  @@index([shopId])
}

enum UserRole {
  CUSTOMER
  MERCHANT
  RUNNER
  ADMIN
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String   // e.g., "Home", "Office"
  street    String
  city      String
  state     String
  pincode   String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)

  @@index([userId])
}

// ---------------------------------------------------------
// E-Commerce Core (Shops & Products)
// ---------------------------------------------------------

model Shop {
  id          String   @id @default(cuid())
  name        String
  category    String   // e.g., "Grocery", "Pharmacy"
  description String?
  bannerImage String?
  logoImage   String?
  rating      Float    @default(5.0)
  status      ShopStatus @default(ACTIVE)
  lat         Float?
  lng         Float?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  products    Product[]
  owners      User[]
  orders      Order[]
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  unit        String   // e.g., "kg", "pack"
  category    String?
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([shopId])
}

// ---------------------------------------------------------
// Shopping Cart
// ---------------------------------------------------------

model CartItem {
  id        String   @id @default(cuid())
  sessionId String?  // Link to guest session
  userId    String?  // Link to authenticated user
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([sessionId])
}

// ---------------------------------------------------------
// Orders & Tracking
// ---------------------------------------------------------

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  deliveryFee   Float       @default(0)
  platformFee   Float       @default(0)
  discount      Float       @default(0)
  deliveryLat   Float?
  deliveryLng   Float?
  
  // New E-commerce specific fields
  paymentMethod String      @default("COD") @map("payment_method")
  paymentStatus String      @default("PENDING") @map("payment_status")
  paymentId     String?     @map("payment_id")
  fulfillmentMethod String  @default("DELIVERY") @map("fulfillment_method")
  assignedAgentId String?   @map("assigned_agent_id")
  batchId         String?   @map("batch_id")
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  items         OrderItem[]
  tracking      OrderTracking?

  @@index([userId])
  @@index([shopId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  priceAtBuy Float

  @@index([orderId])
  @@index([productId])
}

model OrderTracking {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runnerId    String?  // Reference to Runner user
  currentLat  Float?
  currentLng  Float?
  estimatedArrival DateTime?
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Gamification & Wallet
// ---------------------------------------------------------

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fiatBalance Float    @default(0)
  coinBalance Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// 10x Engines Core Tables (Raw SQL Managed)
// ---------------------------------------------------------

model GlobalCatalog {
  id        String   @id @default(cuid())
  name      String
  barcode   String   @unique
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_catalog")
}

model DeliveryAgent {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  currentLat   Float?   @map("current_lat")
  currentLng   Float?   @map("current_lng")
  isOnline     Boolean  @default(false) @map("is_online")
  isAvailable  Boolean  @default(false) @map("is_available")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("delivery_agents")
}
