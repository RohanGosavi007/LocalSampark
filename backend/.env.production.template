# LocalSampark Production Environment Template
# DO NOT COMMIT THE REAL .env.production FILE TO GIT.
# This is a template showing the required variables for production.

# ─── CORE SERVER SETTINGS ───────────────
NODE_ENV=production
PORT=5000
USE_SQLITE=false

# ─── DATABASE SETTINGS ──────────────────
# The connection string for the core PostgreSQL database on Render
DATABASE_URL=postgresql://localsampark_admin:<secure-password>@<render-db-host>:5432/localsampark

# ─── AUTHENTICATION & SECURITY ──────────
# Generate secure, random strings for these (e.g. using `openssl rand -hex 64`)
# DO NOT use "test-secret" or simple strings in production.
JWT_SECRET=<secure-random-string-for-access-tokens>
JWT_REFRESH_SECRET=<secure-random-string-for-refresh-tokens>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── EXTERNAL SERVICES ──────────────────
# Supabase settings for Storage, Auth (if used), etc.
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your-supabase-anon-key>

# Redis caching server (Render or Upstash)
REDIS_URL=rediss://<secure-redis-connection-string>

# Firebase Cloud Messaging for Push Notifications
# Load this securely, do not commit plaintext private keys!
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-service-account-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── TELEMETRY & ERROR TRACKING ─────────
# Sentry DSN for error reporting
SENTRY_DSN=https://<sentry-key>@o<sentry-org>.ingest.sentry.io/<sentry-project>

# ─── 3RD PARTY INTEGRATIONS ─────────────
# MSG91 for SMS/OTP
MSG91_AUTH_KEY=<msg91-auth-key>
MSG91_TEMPLATE_ID=<msg91-template-id>

# Razorpay for Payment Gateway
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
