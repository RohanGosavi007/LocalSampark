# LocalSampark — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=localsampark
DB_USER=postgres
DB_PASSWORD=

# ─── Redis (optional — falls back to in-memory) ─────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (MUST change in production!) ────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Firebase (Auth & Push Notifications) ────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-app",...}'

# ─── Google Maps ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Razorpay (Payments — deferred) ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── MSG91 (SMS OTP for India) ───────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=LSAMPR

# ─── MinIO (Self-hosted S3 — optional) ───────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=localsampark

# ─── OpenAI (Chatbot — optional) ─────────────────────────────
OPENAI_API_KEY=

# ─── Email SMTP ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localsampark.in

# ─── Admin Security ──────────────────────────────────────────
ADMIN_PIN_SALT=CHANGE_THIS_SALT_STRING
ADMIN_ALLOWED_IP_LIST=127.0.0.1,::1

# ─── Pilot Region ────────────────────────────────────────────
PILOT_REGION_NAME=Dhanori
PILOT_REGION_CITY=Pune
PILOT_REGION_STATE=Maharashtra
PILOT_REGION_PINCODE=411015
PILOT_REGION_LAT=18.5913
PILOT_REGION_LNG=73.8987
PILOT_REGION_RADIUS_KM=10
