# LocalSampark — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=localsampark
DB_USER=postgres
DB_PASSWORD=

# ─── Redis (optional — falls back to in-memory) ─────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (MUST change in production!) ────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=1h
# Bill payments are wallet-funded and recorded as 'processing' for an operator to settle.
# Set to false to close them.
BILL_PAY_ENABLED=true
# Admin sessions cannot refresh, so they get their own lifetime.
ADMIN_JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

# ─── Firebase (Auth & Push Notifications) ────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-app",...}'

# ─── Google Maps ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Razorpay (online payments) ──────────────────────────────
# Leave all three empty and online payment is switched off: the API answers
# 503 PAYMENTS_UNAVAILABLE, GET /payments/razorpay/config reports
# enabled:false, and the clients offer cash on delivery and wallet only.
#
# To switch it on:
#   1. Razorpay Dashboard → Account & Settings → API Keys → Generate Key.
#      Use the test-mode pair (rzp_test_…) here, the live pair in production.
#   2. Dashboard → Webhooks → Add: URL https://<api-host>/api/v1/webhooks/razorpay,
#      events payment.captured, payment.failed, order.paid. The secret you type
#      there is RAZORPAY_WEBHOOK_SECRET — it is not the key secret.
# The key id is public (the browser needs it, and the API hands it out); the
# two secrets must never reach a client or the repository.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Login codes ─────────────────────────────────────────────
# SMS codes can be sent through Fast2SMS or MSG91 (MSG91_AUTH_KEY / MSG91_TEMPLATE_ID below).
# For 100% free sandbox delivery, set ALLOW_FREE_OTP_MODE=true.
FAST2SMS_API_KEY=
ALLOW_FREE_OTP_MODE=false
REQUIRE_EMAIL_VERIFICATION=false
# With NODE_ENV=development or test and no provider, the code is printed to the
# console and returned in the response. Anywhere else, no provider means the
# request fails with 503 — a code is never written to the logs of a deployed
# server.
#
# WhatsApp codes (optional). Without the first two, the WhatsApp option
# answers "not available" and clients fall back to SMS.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name and language of an approved AUTHENTICATION template.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ─── Browser origins (CORS) ──────────────────────────────────
# Only these sites may call the API from a browser. localhost is allowed
# automatically when NODE_ENV is development or test, and never otherwise.
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Comma-separated extras, e.g. https://www.example.in,https://example.in
ALLOWED_ORIGINS=

# ─── CCTV alerts webhook ─────────────────────────────────────
# POST /api/v1/societies/cctv/webhook is called by the camera system with
# X-Webhook-Signature: hex HMAC-SHA256 of the raw body under this secret.
# Empty means the route refuses every delivery.
CCTV_WEBHOOK_SECRET=

# ─── Reverse proxy ───────────────────────────────────────────
# How many proxies sit in front of this process (Render's router, nginx, a
# CDN). Decides which address in X-Forwarded-For is the client's, which is what
# the rate limits and the admin IP allow-list go by. Default: 1 in production,
# 0 otherwise. Raise it if a rate-limit log line shows a proxy's address.
TRUST_PROXY_HOPS=

# ─── MSG91 (SMS OTP for India) ───────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=LSAMPR

# ─── MinIO (Self-hosted S3 — optional) ───────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=localsampark

# ─── OpenAI (Chatbot — optional) ─────────────────────────────
OPENAI_API_KEY=

# ─── Email SMTP ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localsampark.in

# ─── Admin Security ──────────────────────────────────────────
ADMIN_PIN_SALT=CHANGE_THIS_SALT_STRING
ADMIN_ALLOWED_IP_LIST=127.0.0.1,::1

# ─── Pilot Region ────────────────────────────────────────────
PILOT_REGION_NAME=Dhanori
PILOT_REGION_CITY=Pune
PILOT_REGION_STATE=Maharashtra
PILOT_REGION_PINCODE=411015
PILOT_REGION_LAT=18.5913
PILOT_REGION_LNG=73.8987
PILOT_REGION_RADIUS_KM=10
