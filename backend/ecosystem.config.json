{
  "apps": [
    {
      "name": "localsampark-api",
      "script": "src/server.js",
      "instances": "max",
      "exec_mode": "cluster",
      "watch": false,
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 5000
      },
      "env_development": {
        "NODE_ENV": "development",
        "PORT": 5000
      },
      "max_memory_restart": "1G",
      "error_file": "logs/pm2-err.log",
      "out_file": "logs/pm2-out.log",
      "merge_logs": true
    }
  ]
}
