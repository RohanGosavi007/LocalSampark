# PRODUCTION ENVIRONMENT TEMPLATE (DO NOT COMMIT SECRETS)
NODE_ENV=production
PORT=5000

# PostgreSQL (Matches docker-compose.yml)
DB_USER=localsampark_user
DB_PASSWORD=YOUR_SECURE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=localsampark

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT and Sessions
JWT_SECRET=YOUR_SECURE_PRODUCTION_JWT_SECRET
JWT_REFRESH_SECRET=YOUR_SECURE_PRODUCTION_REFRESH_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=https://localsampark.in,https://www.localsampark.in,https://admin.localsampark.in,https://localsampark.com,https://www.localsampark.com

# Sentry
SENTRY_DSN=YOUR_BACKEND_SENTRY_DSN

# Razorpay
RAZORPAY_KEY_ID=YOUR_RAZORPAY_LIVE_KEY
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_LIVE_SECRET

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD

# Firebase Admin SDK (For Mobile Push Notifications)
FIREBASE_PROJECT_ID=localsampark-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@localsampark-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"

# Storage
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_S3_BUCKET=localsampark-production-bucket
