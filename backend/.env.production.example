# ═══════════════════════════════════════════════════════════════════════════
# LocalSampark — Production Environment Template (.env.production.example)
#
# STRICT SECURITY NOTICE:
# DO NOT COMMIT THE ACTUAL .env.production FILE TO GIT.
# All values with <placeholder> MUST be filled in your hosting environment
# (e.g. Render Dashboard / Docker Secrets / Cloud Run variables).
# ═══════════════════════════════════════════════════════════════════════════

# ─── CORE SERVER INVARIANTS ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Production MUST use PostgreSQL (never SQLite)
USE_SQLITE=false
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_DEADLINE_MS=25000

# ─── DATABASE SETTINGS (PostgreSQL 15+ with PostGIS) ────────────────────
# Connect to Supabase Free, Neon Free, or Render PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/localsampark?sslmode=require
DB_POOL_MAX=5
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000

# ─── AUTHENTICATION & SECRETS (N1 / N2 Compliance) ──────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=<64-byte-secure-hex-string>
JWT_REFRESH_SECRET=<64-byte-secure-hex-string>
JWT_EXPIRES_IN=1h
ADMIN_JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

# ─── DOMAINS & CORS ─────────────────────────────────────────────────────
# Web client URL (required at boot by envValidator)
CLIENT_URL=https://localsampark.com
FRONTEND_URL=https://localsampark.com
ADMIN_URL=https://admin.localsampark.com
BACKEND_URL=https://api.localsampark.com
ALLOWED_ORIGINS=https://localsampark.com,https://admin.localsampark.com

# ─── OBJECT STORAGE (N3 - Cloudflare R2 / S3 Compatible) ────────────────
# Use 's3' for production S3/R2 storage, 'local' for local dev fallback
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=localsampark-production
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<cloudflare-r2-access-key-id>
STORAGE_SECRET_ACCESS_KEY=<cloudflare-r2-secret-access-key>
STORAGE_PUBLIC_URL=https://media.localsampark.com

# ─── DISASTER RECOVERY & BACKUPS (P10) ──────────────────────────────────
# 32-byte hex key for AES-256-GCM database backup encryption
BACKUP_ENCRYPTION_KEY=<64-hex-char-aes-256-key>
BACKUP_S3_BUCKET=localsampark-backups
BACKUP_RETENTION_DAYS=7

# ─── CACHE & RATE LIMITING ──────────────────────────────────────────────
# When REDIS_URL is omitted, the API automatically falls back to in-memory store
REDIS_URL=rediss://<default>:<password>@<host>:6379

# ─── PUSH NOTIFICATIONS (FCM) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-adminsdk-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── TRANSACTIONAL EMAIL (Brevo / Resend) ────────────────────────────────
BREVO_API_KEY=<brevo-api-key>
EMAIL_FROM="LocalSampark <noreply@localsampark.com>"

# ─── PAYMENT GATEWAYS (D4 - Off by default until KYC is complete) ────────
# Leaving placeholders disables online payment (COD remains available)
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# ─── OBSERVABILITY & SENTRY (P8) ────────────────────────────────────────
SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
SENTRY_ENVIRONMENT=production
