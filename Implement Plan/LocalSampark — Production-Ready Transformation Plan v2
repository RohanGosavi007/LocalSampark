-- Payout configuration
CREATE TABLE payout_config (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  role VARCHAR(30) NOT NULL, -- 'delivery_agent', 'franchise', 'service_provider'
  payout_schedule VARCHAR(20) DEFAULT 'weekly', -- 'daily', 'weekly', 'biweekly', 'monthly'
  min_threshold DECIMAL(10,2) DEFAULT 500,
  payment_method VARCHAR(30) DEFAULT 'bank_transfer', -- 'bank_transfer', 'upi', 'wallet'
  updated_by UUID REFERENCES users(id),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Surge pricing rules
CREATE TABLE surge_rules (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  rule_name VARCHAR(100) NOT NULL,
  condition_type VARCHAR(30), -- 'time_range', 'weather', 'demand'
  condition_params JSONB, -- {"start": "19:00", "end": "21:00"}
  multiplier DECIMAL(3,1) DEFAULT 1.0,
  is_active BOOLEAN DEFAULT TRUE,
  updated_by UUID REFERENCES users(id)
);
