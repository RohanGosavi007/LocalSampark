**Key — Haversine Distance with IP Fallback:**
```js
router.get('/nearby', async (req, res) => {
  let { lat, lng, radius = 5, category } = req.query;
  
  // If no lat/lng provided, try IP-based geolocation
  if (!lat || !lng) {
    const ip = req.headers['x-forwarded-for'] || req.socket.remoteAddress;
    const geo = await ipToGeo(ip); // Uses free ip-api.com or ipinfo.io
    lat = geo.lat; lng = geo.lng;
  }
  
  const shops = await query(`
    SELECT *, 
      (6371 * acos(cos(radians($1)) * cos(radians(latitude)) 
      * cos(radians(longitude) - radians($2)) 
      + sin(radians($1)) * sin(radians(latitude)))) AS distance_km
    FROM local_shops 
    WHERE is_active = 1 AND approval_status = 'approved'
    ${category ? "AND category = $4" : ""}
    ORDER BY distance_km ASC
  `, [lat, lng, radius, ...(category ? [category] : [])]);
  
  res.json({ shops, userLocation: { lat, lng } });
});
```

**Key — Available Slot Calculation:**
```js
router.get('/:id/staff/:sid/slots', async (req, res) => {
  const { date } = req.query; // "2026-07-05"
  const dayOfWeek = new Date(date).getDay();
  
  // 1. Get staff's availability for that day
  const schedule = await queryOne(
    'SELECT * FROM staff_availability WHERE staff_id = $1 AND day_of_week = $2 AND is_available = 1',
    [req.params.sid, dayOfWeek]
  );
  if (!schedule) return res.json({ slots: [], message: 'Staff not available on this day' });
  
  // 2. Check if it's an off-day
  const offDay = await queryOne(
    'SELECT * FROM staff_off_days WHERE staff_id = $1 AND off_date = $2',
    [req.params.sid, date]
  );
  if (offDay) return res.json({ slots: [], message: 'Staff is on leave' });
  
  // 3. Generate all possible slots
  const allSlots = generateTimeSlots(schedule.start_time, schedule.end_time, schedule.slot_duration_minutes);
  
  // 4. Filter out already-booked slots
  const booked = await query(
    "SELECT time_slot FROM shop_appointments WHERE staff_id = $1 AND appointment_date = $2 AND status != 'cancelled'",
    [req.params.sid, date]
  );
  const bookedSlots = new Set(booked.map(b => b.time_slot));
  
  // 5. Apply surge pricing
  const surgeRules = await query(
    'SELECT * FROM surge_pricing_rules WHERE shop_id = $1 AND (day_of_week = $2 OR day_of_week IS NULL) AND is_active = 1',
    [req.params.id, dayOfWeek]
  );
  
  const availableSlots = allSlots
    .filter(slot => !bookedSlots.has(slot))
    .map(slot => ({
      time: slot,
      surgeMultiplier: getSurgeMultiplier(slot, surgeRules)
    }));
  
  res.json({ slots: availableSlots });
});
```

