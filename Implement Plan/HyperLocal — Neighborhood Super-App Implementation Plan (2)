### Socket.io Server Architecture

```javascript
// Namespace-based isolation
const chatNamespace = io.of('/chat');
const deliveryNamespace = io.of('/delivery');
const feedNamespace = io.of('/feed');

// Delivery tracking - Agent sends location
deliveryNamespace.on('connection', (socket) => {
  
  // Agent broadcasts location every 5 seconds
  socket.on('agent:location', async (data) => {
    const { agentId, lat, lng, deliveryId } = data;
    
    // Store in Redis for instant access
    await redis.setex(`agent:${agentId}:location`, 30, JSON.stringify({ lat, lng }));
    
    // Persist to PostgreSQL for route history
    await db.query(
      'INSERT INTO delivery_tracking (delivery_id, agent_id, coordinate, recorded_at) VALUES ($1, $2, ST_MakePoint($3, $4)::geography, NOW())',
      [deliveryId, agentId, lng, lat]
    );
    
    // Broadcast to user watching this delivery
    socket.to(`delivery:${deliveryId}`).emit('delivery:location_update', { lat, lng });
    
    // Check geofence triggers
    await checkGeofenceStatus(deliveryId, agentId, lat, lng);
  });
});
```

