### Delivery Fee Calculation Engine

```javascript
// Distance-based pricing model
function calculateDeliveryFee(distanceKm) {
  const BASE_FEE = 20;          // ₹20 base fee
  const PER_KM_RATE = 8;        // ₹8 per km
  const SURGE_MULTIPLIER = 1.5; // During peak hours
  const PLATFORM_CUT = 0.15;    // 15% platform commission
  
  let fee = BASE_FEE + (distanceKm * PER_KM_RATE);
  
  // Surge pricing during peak hours (12-2 PM, 7-10 PM)
  if (isPeakHour()) {
    fee *= SURGE_MULTIPLIER;
  }
  
  // Cap at ₹80 for hyperlocal
  fee = Math.min(fee, 80);
  
  return {
    totalFee: Math.round(fee),
    agentPayout: Math.round(fee * (1 - PLATFORM_CUT)),
    platformCommission: Math.round(fee * PLATFORM_CUT)
  };
}
```

### Geofencing Auto-Status Updates

```sql
-- Check if agent has entered shop's geofence (100m radius)
SELECT 
    ST_DWithin(
        da.current_coordinate,
        ls.coordinate,
        100  -- 100 meters geofence
    ) AS agent_at_shop
FROM delivery_agents da
JOIN deliveries d ON d.agent_id = da.id
JOIN local_shops ls ON ls.id = d.shop_id
WHERE d.id = :delivery_id;
