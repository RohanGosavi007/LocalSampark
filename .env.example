# ═══════════════════════════════════════════════════════════════════════════
# LocalSampark — master environment variable list
#
# One place that names every variable the platform reads. Copy the sections you
# need into the real environment of each service; never commit real values.
#
#   [API]     backend  (Render web service "localsampark-api", or docker `api`)
#   [WEB]     apps/web   (Next.js; NEXT_PUBLIC_* is baked into the browser bundle at BUILD time)
#   [ADMIN]   apps/admin (Next.js; same rule)
#   [MOBILE]  apps/mobile (EXPO_PUBLIC_* is inlined by Metro at BUILD time)
#
# REQUIRED = the process refuses to start (or the feature is off) without it.
# A value in <angle-brackets> is a placeholder and is treated as UNSET.
# backend/src/__tests__/envDocumentation.test.js fails if the code reads a variable
# that is not listed in this file.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Core [API] ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# true = SQLite file (development / tests only). Production must be false.
USE_SQLITE=false
SQLITE_DB_PATH=
LOG_LEVEL=info
APP_VERSION=
# Commit shown on /health. Render injects RENDER_GIT_COMMIT itself; set GIT_COMMIT elsewhere.
GIT_COMMIT=
# Number of reverse proxies in front of the API (decides which X-Forwarded-For entry is the client).
TRUST_PROXY_HOPS=1
# Graceful shutdown budget (ms). Must finish inside the platform's SIGTERM→SIGKILL window.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_DEADLINE_MS=25000
# off = disable the cross-instance cron/interval locks (single instance only).
JOB_LOCKS=

# ─── Database [API] ────────────────────────────────────────────────────────
# REQUIRED in production. PostgreSQL 15+ with PostGIS.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/localsampark
# Used only when DATABASE_URL is unset (e.g. a Supabase direct connection).
DIRECT_URL=
DB_POOL_MAX=
DB_QUERY_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
# false = connect without TLS (local docker only).
DB_SSL=
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=
DB_REGION=singapore
# Alternative to DATABASE_URL (local docker): discrete connection settings.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DEBUG=
# true = also seed the demo data set in production (never on a live database).
SEED_DEMO=
# true = serve the bundled mock shop catalogue. Ignored when NODE_ENV=production.
USE_MOCK_CATALOG=

# ─── Cache / queues [API] ──────────────────────────────────────────────────
# REQUIRED in production. rediss:// for TLS (Upstash / Render Redis).
REDIS_URL=rediss://<redis-connection-string>
# Alternative to REDIS_URL (local docker).
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ─── Auth & sessions [API] ─────────────────────────────────────────────────
# REQUIRED. At least 32 random characters (openssl rand -hex 64). Weak values are refused in production.
JWT_SECRET=<random-64-hex>
JWT_REFRESH_SECRET=<random-64-hex>
# Access-token lifetime for users and for the admin console. Web/mobile refresh silently.
JWT_EXPIRES_IN=1h
ADMIN_JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

# ─── Public URLs & CORS [API] ──────────────────────────────────────────────
# REQUIRED in production: the web app's public origin (CORS + links in emails).
CLIENT_URL=https://www.example.in
# Admin console origin. ALLOWED_ORIGINS takes any others, comma-separated.
ADMIN_URL=https://admin.example.in
ALLOWED_ORIGINS=
# Used to build links in emails. Unset, verification and tracking links point at localhost.
BACKEND_URL=https://api.example.in
FRONTEND_URL=https://www.example.in
CDN_BASE_URL=
# Injected by Render; read for CORS defaults and the health endpoint.
RENDER=
RENDER_EXTERNAL_URL=
RENDER_GIT_COMMIT=
RENDER_INSTANCE_ID=
RENDER_REGION=
RENDER_SERVICE_ID=
HOSTNAME=

# ─── Payments [API] ────────────────────────────────────────────────────────
# Until all three Razorpay values are real, online payment answers 503 PAYMENTS_UNAVAILABLE and
# cash-on-delivery / wallet keep working. The webhook secret is the one typed into
# Razorpay Dashboard → Webhooks (URL https://<api>/api/v1/webhooks/razorpay), not the key secret.
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
CASHFREE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
SAAS_WEBHOOK_SECRET=
# false = close bill payments (they are recorded for an operator to settle; there is no biller integration).
BILL_PAY_ENABLED=
# HMAC secret for POST /societies/cctv/webhook. Unset, that route refuses every delivery.
CCTV_WEBHOOK_SECRET=

# ─── Object Storage (S3 / Cloudflare R2 / MinIO) [API] ────────────────────
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Messaging & push [API] ────────────────────────────────────────────────
MSG91_AUTH_KEY=<msg91-auth-key>
MSG91_TEMPLATE_ID=<msg91-template-id>
MSG91_SENDER_ID=
FAST2SMS_API_KEY=
ALLOW_FREE_OTP_MODE=
REQUIRE_EMAIL_VERIFICATION=
WHATSAPP_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<service-account-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative to the three FIREBASE_* values: the whole service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
EXPO_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Third-party services [API] ────────────────────────────────────────────
GEMINI_API_KEY=
GST_API_KEY=
TALLY_URL=
# Typesense is optional; shop search falls back to the in-process hybrid searcher without it.
TYPESENSE_HOST=
TYPESENSE_PORT=
TYPESENSE_PROTOCOL=
TYPESENSE_API_KEY=
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose to a browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=

# ─── Web app [WEB] ─────────────────────────────────────────────────────────
# The API's public origin. Either https://api.example.in or https://api.example.in/api/v1 is accepted.
NEXT_PUBLIC_API_URL=https://api.example.in
NEXT_PUBLIC_SITE_URL=https://www.example.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
# Firebase web config (web push). All six come from the Firebase console → Project settings → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_RUNTIME=

# ─── Admin console [ADMIN] ─────────────────────────────────────────────────
# Same convention as the web app. (NEXT_PUBLIC_API_URL above is read by both.)

# ─── Mobile app [MOBILE] ───────────────────────────────────────────────────
# Release builds ignore a dev URL and use this (or the production default).
EXPO_PUBLIC_API_URL=https://api.example.in/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Unset disables crash reporting; it never breaks a build or launch.
EXPO_PUBLIC_SENTRY_DSN=
