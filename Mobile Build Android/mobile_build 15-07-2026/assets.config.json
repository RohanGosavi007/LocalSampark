{
  "expo": {
    "name": "LocalSampark",
    "slug": "localsampark",
    "scheme": "localsampark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "android": {
      "package": "com.localsampark.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "*.localsampark.in",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.localsampark.app",
      "associatedDomains": [
        "applinks:localsampark.in"
      ]
    }
  },
  "store_assets": {
    "play_store": {
      "icon_size": "512x512",
      "feature_graphic": "1024x500",
      "screenshots": [
        "phone_1",
        "phone_2",
        "phone_3"
      ]
    },
    "app_store": {
      "icon_size": "1024x1024",
      "screenshots": [
        "iphone_6.5_1",
        "iphone_6.5_2",
        "ipad_12.9_1"
      ]
    }
  }
}
