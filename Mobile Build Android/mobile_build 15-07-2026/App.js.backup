import React, { useState, useEffect } from 'react';
import { StyleSheet, Text, View, TouchableOpacity, TextInput, ScrollView, SafeAreaView, StatusBar, Modal, Alert, Switch, Image } from 'react-native';
import en from './src/i18n/en.json';
import hi from './src/i18n/hi.json';
import mr from './src/i18n/mr.json';

const API_URL = 'http://10.0.2.2:5000/api/v1';

export default function App() {
  const [currentScreen, setCurrentScreen] = useState('Login'); // Login, OTP, Home, Shops, ShopDetails, Chat, ChatActive, Profile, Jobs, Properties, Marketplace, Pets, Health, Wallet, OrderTracking, DeliveryAgentDashboard, SocietyDetails, Carpool, ARDiscovery, Events, Earn, Franchise
  const [phoneNumber, setPhoneNumber] = useState('');
  const [otp, setOtp] = useState('');
  const [isDarkMode, setIsDarkMode] = useState(false);
  const [lang, setLang] = useState('en'); // 'en', 'hi', 'mr'
  const [selectedRegion, setSelectedRegion] = useState('Dhanori'); 
  const [authToken, setAuthToken] = useState(null);
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(false);
  
  // Lists
  const [feedPosts, setFeedPosts] = useState([
    { id: 'mock-1', full_name: 'Sports Committee', post_type: 'discussion', content: 'Join us this weekend for the annual local cricket cup at Dhanori ground. Contact sports committee for details.', upvotes: 12, downvotes: 1 }
  ]);
  const [shopsList, setShopsList] = useState([]);
  const [selectedCategory, setSelectedCategory] = useState('All');

  const categoriesList = [
    'All',
    'Grocery & Supermarkets',
    'Restaurants & Cafes',
    'Pharmacy & Healthcare',
    'Home Services & Plumbers',
    'Salon, Beauty & Spa',
    'Electricians & Electronics',
    'Tutors & Education',
    'Hardware & Sanitary',
    'Clothing & Fashion',
    'Gym & Fitness',
    'Real Estate & Brokers',
    'Automotive & Mechanic'
  ];
  
  // Shop Details State
  const [selectedShop, setSelectedShop] = useState(null);
  const [shopProducts, setShopProducts] = useState([]);
  const [shopStaff, setShopStaff] = useState([]);
  const [shopOffers, setShopOffers] = useState([]);
  const [cart, setCart] = useState({});
  const [selectedStaffMember, setSelectedStaffMember] = useState(null);
  const [bookingDate, setBookingDate] = useState('');
  const [bookingTime, setBookingTime] = useState('');
  const [showPaymentModal, setShowPaymentModal] = useState(false);
  const [selectedPaymentMethod, setSelectedPaymentMethod] = useState('COD');
  
  // Franchise Pending Approvals
  const [pendingShops, setPendingShops] = useState([]);

  // Chat states
  const [activeChatRoom, setActiveChatRoom] = useState(null);
  const [messages, setMessages] = useState([]);
  const [inputMessage, setInputMessage] = useState('');

  // Marketplace states
  const [marketItems, setMarketItems] = useState([
    { id: 1, title: 'Used Wooden Study Table', price: '₹1,500', cond: 'Good', desc: 'Slight scratches but very sturdy. Perfect for students.', seller: 'Amit Patil' },
    { id: 2, title: 'Office Chair (Ergonomic)', price: '₹2,200', cond: 'Like New', desc: 'Bought 3 months ago. Adjustable height and lumbar support.', seller: 'Neha Shinde' }
  ]);

  // Pet states
  const [petsList, setPetsList] = useState([
    { id: 1, name: 'Bruno', species: 'Dog', breed: 'Golden Retriever', age: '2 yrs', isLost: false }
  ]);
  const [petAlerts, setPetAlerts] = useState([
    { id: 1, petName: 'Coco', breed: 'Persian Cat', desc: 'Lost near Ganga Aria society block C. White fur, wearing blue collar.', contact: '9876543211' }
  ]);

  // Wallet states
  const [walletBalance, setWalletBalance] = useState(750.00);
  const [walletTransactions, setWalletTransactions] = useState([
    { id: 1, amount: '₹120', type: 'debit', purpose: 'Paid at Sharma Grocery', time: 'Today, 11:30 AM' },
    { id: 2, amount: '₹500', type: 'credit', purpose: 'Loaded via Razorpay', time: 'Yesterday, 4:15 PM' }
  ]);

  // Carpool states
  const [carpoolRides, setCarpoolRides] = useState([
    { id: 1, driver: 'Ramesh Patil', from: 'Dhanori Chowk', to: 'Hinjewadi Phase 1', date: 'Tomorrow', time: '9:00 AM', price: '₹50/seat', seats: 2 }
  ]);

  // Emergency SOS state
  const [sosActive, setSosActive] = useState(false);

  const t = (key) => {
    const dictionaries = { en, hi, mr };
    return (dictionaries[lang] && dictionaries[lang][key]) || (en && en[key]) || key;
  };

  // Fetch shops dynamically
  const fetchShops = async () => {
    try {
      const res = await fetch(`${API_URL}/shops`);
      const data = await res.json();
      const shops = Array.isArray(data) ? data : (data.rows || []);
      setShopsList(shops);
    } catch (err) {
      console.warn('Failed to fetch shops', err);
    }
  };

  // Fetch details when shop selected
  const viewShopDetails = async (shop) => {
    setSelectedShop(shop);
    setCart({});
    setSelectedStaffMember(null);
    setBookingDate('');
    setBookingTime('');
    setCurrentScreen('ShopDetails');

    try {
      const offersRes = await fetch(`${API_URL}/shops/${shop.id}/offers`);
      const offersData = await offersRes.json();
      setShopOffers(Array.isArray(offersData) ? offersData : (offersData.rows || []));

      if (shop.shop_type === 'retail' || shop.shop_type === 'both' || !shop.shop_type) {
        const prodRes = await fetch(`${API_URL}/shops/${shop.id}/products`);
        const prodData = await prodRes.json();
        setShopProducts(Array.isArray(prodData) ? prodData : (prodData.rows || []));
      }

      if (shop.shop_type === 'appointment' || shop.shop_type === 'both') {
        const staffRes = await fetch(`${API_URL}/shops/${shop.id}/staff`);
        const staffData = await staffRes.json();
        setShopStaff(Array.isArray(staffData) ? staffData : (staffData.rows || []));
      }
    } catch (err) {
      console.warn('Error loading shop detailed resources', err);
    }
  };

  // Fetch Pending Franchise approvals
  const fetchPendingApprovals = async (token) => {
    try {
      const res = await fetch(`${API_URL}/territory/pending-approvals`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      setPendingShops(Array.isArray(data) ? data : (data.rows || []));
    } catch (err) {
      console.warn('Failed to load pending applications', err);
    }
  };

  // Perform shop approval
  const handleApproveShop = async (shopId, status) => {
    try {
      const res = await fetch(`${API_URL}/territory/approve-shop`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${authToken}`
        },
        body: JSON.stringify({ shopId, status })
      });
      const data = await res.json();
      if (data.success) {
        Alert.alert('Success', `Shop has been ${status} successfully!`);
        fetchPendingApprovals(authToken);
        fetchShops();
      } else {
        Alert.alert('Failed', data.error || 'Operation failed');
      }
    } catch (err) {
      Alert.alert('Error', 'Unable to complete approval request');
    }
  };

  useEffect(() => {
    fetchShops();
  }, []);

  const handleSendOtp = () => {
    if (!phoneNumber) {
      Alert.alert('Error', 'Please enter your phone number');
      return;
    }
    // Simple mock developer fallback
    setOtp('123456');
    setCurrentScreen('OTP');
  };

  const handleVerifyOtp = () => {
    // Generate standard mock user
    setAuthToken('mock-jwt-token');
    const mockUser = { id: 'mock-user-id', phone_number: phoneNumber, full_name: 'Resident Dev', role: 'user' };
    setUser(mockUser);
    setCurrentScreen('Home');
  };

  // Developer Preset logins mapping
  const handleDeveloperPresetLogin = async (role) => {
    setLoading(true);
    const rolePhones = {
      'user': '+919000000001',
      'resident_member': '+919000000002',
      'society_admin': '+919000000003',
      'security_guard': '+919000000004',
      'shop_owner': '+919000000005',
      'service_provider': '+919000000006',
      'delivery_agent': '+919000000007',
      'field_agent': '+919000000008',
      'area_agent': '+919000000009',
      'territory_admin': '+919000000010',
      'moderator': '+919000000011',
      'super_admin': '+919000000012'
    };

    const phone = rolePhones[role] || '+919000000001';
    
    try {
      // Hit actual endpoints
      const sendRes = await fetch(`${API_URL}/auth/send-otp`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phoneNumber: phone })
      });
      const sendData = await sendRes.json();
      const mockOtp = sendData.otp || '123456';

      const verifyRes = await fetch(`${API_URL}/auth/verify-otp`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phoneNumber: phone, otp: mockOtp })
      });
      const verifyData = await verifyRes.json();

      if (verifyData.registered) {
        setAuthToken(verifyData.accessToken);
        setUser(verifyData.user);
        
        // Load pending approvals if admin
        const adminRoles = ['super_admin', 'territory_admin', 'area_agent', 'moderator'];
        if (adminRoles.includes(verifyData.user.role)) {
          fetchPendingApprovals(verifyData.accessToken);
        }
        
        setCurrentScreen('Home');
      } else {
        Alert.alert('Register Required', 'Profile registration is needed on the website.');
      }
    } catch (err) {
      Alert.alert('Dev Preset Failed', 'Backend server might not be running.');
    } finally {
      setLoading(false);
    }
  };

  const handleSOS = () => {
    setSosActive(true);
    Alert.alert('🚨 SOS EMERGENCY BROADCAST SENT!', 'Your coordinates and alert have been broadcasted to all neighbor devices in a 5km radius.');
  };

  // Add items to Cart
  const updateCart = (productId, delta, price) => {
    setCart(prev => {
      const currentQty = prev[productId]?.qty || 0;
      const nextQty = Math.max(0, currentQty + delta);
      if (nextQty === 0) {
        const copy = { ...prev };
        delete copy[productId];
        return copy;
      }
      return { ...prev, [productId]: { qty: nextQty, price } };
    });
  };

  const getCartTotal = () => {
    return Object.values(cart).reduce((sum, item) => sum + (item.price * item.qty), 0);
  };

  // Submit Order / Appointment
  const processPlatformPayment = async () => {
    if (!authToken) {
      Alert.alert('Error', 'Please log in first.');
      setCurrentScreen('Login');
      return;
    }

    try {
      if (selectedShop.shop_type === 'appointment') {
        const res = await fetch(`${API_URL}/shops/${selectedShop.id}/appointments`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({
            staffId: selectedStaffMember,
            appointmentDate: bookingDate,
            timeSlot: bookingTime,
            paymentMethod: selectedPaymentMethod
          })
        });
        const data = await res.json();
        if (data.success) {
          if (selectedPaymentMethod === 'RAZORPAY') {
            Alert.alert('Razorpay Gateway', `Payment Intent Generated: ${data.razorpayOrder.id}. Secure payment verified!`);
          } else {
            if (selectedPaymentMethod === 'WALLET') {
              setWalletBalance(prev => prev - 150); // mock flat appointment cost
              setWalletTransactions(prev => [{ id: Date.now(), amount: '₹150', type: 'debit', purpose: 'Booked Appointment', time: 'Just now' }, ...prev]);
            }
            Alert.alert('Success', 'Appointment Booked Successfully!');
          }
          setShowPaymentModal(false);
          setCurrentScreen('Home');
        } else {
          Alert.alert('Failed', data.error || 'Booking failed');
        }
      } else {
        const cartItems = Object.entries(cart).map(([productId, item]) => ({
          id: productId,
          quantity: item.qty,
          price: item.price
        }));

        const res = await fetch(`${API_URL}/shops/${selectedShop.id}/orders`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({
            items: cartItems,
            totalAmount: getCartTotal(),
            paymentMethod: selectedPaymentMethod
          })
        });
        const data = await res.json();
        if (data.success) {
          if (selectedPaymentMethod === 'RAZORPAY') {
            Alert.alert('Razorpay Gateway', `Order OrderID Generated: ${data.razorpayOrder.id}. Secure payment completed!`);
          } else {
            if (selectedPaymentMethod === 'WALLET') {
              const total = getCartTotal();
              setWalletBalance(prev => prev - total);
              setWalletTransactions(prev => [{ id: Date.now(), amount: `₹${total}`, type: 'debit', purpose: 'Paid at Shop', time: 'Just now' }, ...prev]);
            }
            Alert.alert('Success', 'Order Placed Successfully!');
          }
          setCart({});
          setShowPaymentModal(false);
          setCurrentScreen('Home');
        } else {
          Alert.alert('Failed', data.error || 'Checkout failed');
        }
      }
    } catch (err) {
      Alert.alert('Error', 'Checkout connection timed out');
    }
  };

  // Styling palette depending on Dark/Light theme - HSL optimized look
  const colors = isDarkMode ? {
    bg: '#060b18',
    card: '#0d1526',
    text: '#f1f5f9',
    textMuted: '#94a3b8',
    primary: '#6366f1',
    primaryLight: 'rgba(99, 102, 241, 0.15)',
    accent: '#f97316',
    border: '#1e2d4a',
    bubbleSelf: '#6366f1',
    bubbleOther: '#0d1526'
  } : {
    bg: '#f0f4ff',
    card: '#ffffff',
    text: '#0f172a',
    textMuted: '#475569',
    primary: '#4f46e5',
    primaryLight: '#ede9fe',
    accent: '#f97316',
    border: '#dde3f5',
    bubbleSelf: '#4f46e5',
    bubbleOther: '#e2e8f0'
  };

  const renderScreen = () => {
    switch (currentScreen) {
      case 'Login':
        return (
          <ScrollView style={{ flex: 1, backgroundColor: colors.bg }} contentContainerStyle={{ padding: 24, justifyContent: 'center' }}>
            <View style={{ alignItems: 'center', marginVertical: 32 }}>
              <Text style={{ fontSize: 50, marginBottom: 10 }}>🏘️</Text>
              <Text style={[styles.title, { color: colors.primary }]}>LocalSampark</Text>
              <Text style={[styles.subtitle, { color: colors.textMuted }]}>Neighborhood Doorstep Super-App</Text>
            </View>
            
            <View style={styles.inputContainer}>
              <Text style={[styles.label, { color: colors.text }]}>Phone Number</Text>
              <TextInput
                style={[styles.input, { borderColor: colors.border, color: colors.text, backgroundColor: colors.card }]}
                placeholder="+91 XXXXX XXXXX"
                placeholderTextColor={colors.textMuted}
                keyboardType="phone-pad"
                value={phoneNumber}
                onChangeText={setPhoneNumber}
              />
            </View>

            <TouchableOpacity
              style={[styles.button, { backgroundColor: colors.primary }]}
              onPress={handleSendOtp}
            >
              <Text style={styles.buttonText}>Send OTP Code</Text>
            </TouchableOpacity>

            {/* Quick Developer Presets Panel */}
            <View style={{ marginTop: 24, borderTopWidth: 1, borderColor: colors.border, paddingTop: 16 }}>
              <Text style={{ fontSize: 11, fontWeight: '700', color: colors.textMuted, textAlign: 'center', marginBottom: 12 }}>
                ⚡ QUICK DEVELOPER PRESET LOGINS
              </Text>
              
              <Text style={{ fontSize: 10, fontWeight: 'bold', color: colors.textMuted, marginBottom: 4 }}>Resident & Community:</Text>
              <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6, marginBottom: 12 }}>
                {['user', 'resident_member', 'society_admin', 'security_guard'].map(role => (
                  <TouchableOpacity key={role} onPress={() => handleDeveloperPresetLogin(role)} style={[styles.presetBtn, { backgroundColor: colors.card, borderColor: colors.border }]}>
                    <Text style={{ fontSize: 10, color: colors.text, textTransform: 'capitalize' }}>{role.replace('_', ' ')}</Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text style={{ fontSize: 10, fontWeight: 'bold', color: colors.textMuted, marginBottom: 4 }}>Business & Providers:</Text>
              <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6, marginBottom: 12 }}>
                {['shop_owner', 'service_provider', 'delivery_agent'].map(role => (
                  <TouchableOpacity key={role} onPress={() => handleDeveloperPresetLogin(role)} style={[styles.presetBtn, { backgroundColor: colors.card, borderColor: colors.border }]}>
                    <Text style={{ fontSize: 10, color: colors.text, textTransform: 'capitalize' }}>{role.replace('_', ' ')}</Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text style={{ fontSize: 10, fontWeight: 'bold', color: colors.textMuted, marginBottom: 4 }}>Admin & Franchise:</Text>
              <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6 }}>
                {['field_agent', 'area_agent', 'territory_admin', 'moderator', 'super_admin'].map(role => (
                  <TouchableOpacity key={role} onPress={() => handleDeveloperPresetLogin(role)} style={[styles.presetBtn, { backgroundColor: colors.card, borderColor: colors.border }]}>
                    <Text style={{ fontSize: 10, color: colors.text, textTransform: 'capitalize' }}>{role.replace('_', ' ')}</Text>
                  </TouchableOpacity>
                ))}
              </View>
            </View>
          </ScrollView>
        );

      case 'OTP':
        return (
          <View style={[styles.centerContainer, { backgroundColor: colors.bg }]}>
            <Text style={[styles.title, { color: colors.primary }]}>Enter OTP</Text>
            <Text style={[styles.subtitle, { color: colors.textMuted }]}>Enter 6-digit verification code</Text>
            
            <View style={styles.inputContainer}>
              <TextInput
                style={[styles.input, { borderColor: colors.border, color: colors.text, backgroundColor: colors.card, textAlign: 'center' }]}
                placeholder="XXXXXX"
                placeholderTextColor={colors.textMuted}
                keyboardType="number-pad"
                value={otp}
                onChangeText={setOtp}
              />
            </View>

            <TouchableOpacity
              style={[styles.button, { backgroundColor: colors.primary }]}
              onPress={handleVerifyOtp}
            >
              <Text style={styles.buttonText}>Verify & Login</Text>
            </TouchableOpacity>
          </View>
        );

      case 'Home':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <Text style={[styles.headerTitle, { color: colors.primary }]}>🏘️ LocalSampark</Text>
              <Text style={{ color: colors.textMuted }}>{selectedRegion}, Pune | Role: {user?.role || 'Guest'}</Text>
            </View>

            {/* Quick Tiles Grid */}
            <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 10, marginVertical: 15 }}>
              {[
                { screen: 'Shops', icon: '🏪', label: 'Local Directory' },
                { screen: 'Wallet', icon: '👛', label: 'Wallet' },
                { screen: 'SocietyDetails', icon: '🏘️', label: 'Society Gate' },
                { screen: 'Carpool', icon: '🚗', label: 'Carpool' },
                { screen: 'Events', icon: '🎫', label: 'Events' },
                { screen: 'Pets', icon: '🐾', label: 'Pets' },
                { screen: 'Health', icon: '❤️', label: 'Health/SOS' },
                { screen: 'Earn', icon: '💰', label: 'Earn Money' },
                { screen: 'Franchise', icon: '🤝', label: 'Partner Portal' },
                { screen: 'Marketplace', icon: '🛍️', label: 'Buy & Sell' },
                { screen: 'Properties', icon: '🏢', label: 'Properties' },
              ].map((tile, i) => (
                <TouchableOpacity key={i} onPress={() => {
                  if (tile.screen === 'Shops') { fetchShops(); }
                  setCurrentScreen(tile.screen);
                }} style={[styles.tile, { backgroundColor: colors.card, borderColor: colors.border }]}>
                  <Text style={{ fontSize: 22 }}>{tile.icon}</Text>
                  <Text style={{ color: colors.text, fontSize: 11, marginTop: 4, textAlign: 'center' }}>{tile.label}</Text>
                </TouchableOpacity>
              ))}
            </View>

            {/* Local Feed posts */}
            <Text style={{ fontWeight: 'bold', color: colors.text, marginVertical: 10 }}>Local Community Feed</Text>
            {feedPosts.map((post) => (
              <View key={post.id} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
                <Text style={{ color: colors.text, fontWeight: 'bold' }}>📢 Post by {post.full_name}</Text>
                <Text style={{ color: colors.textMuted, marginTop: 5 }}>{post.content}</Text>
              </View>
            ))}
          </ScrollView>
        );

      case 'Shops':
        const filteredShopsList = selectedCategory === 'All' 
          ? shopsList 
          : shopsList.filter(shop => shop.category === selectedCategory);

        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🏪 Local Business Directory</Text>
              <Text style={{ color: colors.textMuted }}>Direct, commission-free neighborhood ordering</Text>
            </View>

            {/* Horizontal scroll category selector */}
            <ScrollView 
              horizontal 
              showsHorizontalScrollIndicator={false} 
              style={{ marginVertical: 10, paddingBottom: 5 }}
            >
              {categoriesList.map(cat => (
                <TouchableOpacity 
                  key={cat} 
                  onPress={() => setSelectedCategory(cat)}
                  style={[
                    styles.categoryChip, 
                    { 
                      backgroundColor: selectedCategory === cat ? colors.primary : colors.card,
                      borderColor: colors.border
                    }
                  ]}
                >
                  <Text style={{ 
                    color: selectedCategory === cat ? '#fff' : colors.text,
                    fontSize: 11, 
                    fontWeight: 'bold' 
                  }}>
                    {cat}
                  </Text>
                </TouchableOpacity>
              ))}
            </ScrollView>

            {filteredShopsList.length > 0 ? (
              filteredShopsList.map((shop) => (
                <TouchableOpacity key={shop.id} onPress={() => viewShopDetails(shop)} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
                  <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
                    <Text style={{ color: colors.text, fontWeight: 'bold', fontSize: 16 }}>{shop.name}</Text>
                    <View style={{ backgroundColor: colors.primaryLight, paddingHorizontal: 8, paddingVertical: 2, borderRadius: 50 }}>
                      <Text style={{ color: colors.primary, fontSize: 10, fontWeight: '700' }}>{shop.shop_type === 'appointment' ? 'Appointments' : 'Online Orders'}</Text>
                    </View>
                  </View>
                  <Text style={{ color: colors.textMuted, marginTop: 4 }}>📍 {shop.address} | Category: {shop.category}</Text>
                  <Text style={{ color: colors.primary, fontWeight: 'bold', marginTop: 4, fontSize: 11 }}>📞 Contact: {shop.phone_number}</Text>
                </TouchableOpacity>
              ))
            ) : (
              <View style={{ padding: 40, alignItems: 'center' }}>
                <Text style={{ color: colors.textMuted }}>No active approved shops found for this category.</Text>
              </View>
            )}
          </ScrollView>
        );

      case 'ShopDetails':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Shops')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back to Directory</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>{selectedShop?.name}</Text>
              <Text style={{ color: colors.textMuted }}>{selectedShop?.category} | 📍 {selectedShop?.address}</Text>
            </View>

            {/* Active Offers */}
            {shopOffers.length > 0 && shopOffers.map(offer => (
              <View key={offer.id} style={{ backgroundColor: '#10b981', padding: 12, borderRadius: 8, marginBottom: 15 }}>
                <Text style={{ color: '#fff', fontWeight: 'bold' }}>🎉 OFFER: {offer.discount_percentage}% OFF</Text>
                <Text style={{ color: '#d1fae5', fontSize: 12 }}>{offer.title}</Text>
              </View>
            ))}

            {/* Render Retail View */}
            {(selectedShop?.shop_type === 'retail' || selectedShop?.shop_type === 'both' || !selectedShop?.shop_type) && (
              <View style={{ marginBottom: 20 }}>
                <Text style={{ fontWeight: 'bold', color: colors.text, fontSize: 16, marginBottom: 10 }}>Products / Menu</Text>
                {shopProducts.map(product => {
                  const qty = cart[product.id]?.qty || 0;
                  return (
                    <View key={product.id} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }]}>
                      <View style={{ flex: 1 }}>
                        <Text style={{ color: colors.text, fontWeight: 'bold' }}>{product.name}</Text>
                        <Text style={{ color: colors.textMuted, fontSize: 12 }}>{product.description}</Text>
                        <Text style={{ color: colors.primary, fontWeight: 'bold', marginTop: 4 }}>₹{product.price}</Text>
                      </View>
                      <View style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        {qty > 0 && (
                          <TouchableOpacity onPress={() => updateCart(product.id, -1, product.price)} style={[styles.cartBadgeBtn, { backgroundColor: colors.primaryLight }]}>
                            <Text style={{ color: colors.primary, fontWeight: 'bold' }}>-</Text>
                          </TouchableOpacity>
                        )}
                        {qty > 0 && <Text style={{ color: colors.text, fontWeight: 'bold' }}>{qty}</Text>}
                        <TouchableOpacity onPress={() => updateCart(product.id, 1, product.price)} style={[styles.cartBadgeBtn, { backgroundColor: colors.primary }]}>
                          <Text style={{ color: '#fff', fontWeight: 'bold' }}>+</Text>
                        </TouchableOpacity>
                      </View>
                    </View>
                  );
                })}
              </View>
            )}

            {/* Render Appointment View */}
            {(selectedShop?.shop_type === 'appointment' || selectedShop?.shop_type === 'both') && (
              <View style={{ marginBottom: 20 }}>
                <Text style={{ fontWeight: 'bold', color: colors.text, fontSize: 16, marginBottom: 10 }}>Select Professional / Staff</Text>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} style={{ marginBottom: 15 }}>
                  {shopStaff.map(staffMember => (
                    <TouchableOpacity 
                      key={staffMember.id}
                      onPress={() => setSelectedStaffMember(staffMember.id)}
                      style={[
                        styles.staffCard, 
                        { backgroundColor: colors.card, borderColor: selectedStaffMember === staffMember.id ? colors.primary : colors.border }
                      ]}
                    >
                      <Text style={{ fontSize: 24 }}>👤</Text>
                      <Text style={{ color: colors.text, fontWeight: 'bold', marginTop: 4 }}>{staffMember.name}</Text>
                      <Text style={{ color: colors.textMuted, fontSize: 11 }}>{staffMember.role}</Text>
                    </TouchableOpacity>
                  ))}
                </ScrollView>

                <Text style={{ fontWeight: 'bold', color: colors.text, fontSize: 14, marginBottom: 6 }}>Booking Date (YYYY-MM-DD)</Text>
                <TextInput 
                  style={[styles.input, { borderColor: colors.border, color: colors.text, backgroundColor: colors.card, marginBottom: 12 }]} 
                  placeholder="e.g. 2026-06-28" 
                  placeholderTextColor={colors.textMuted}
                  value={bookingDate}
                  onChangeText={setBookingDate}
                />

                <Text style={{ fontWeight: 'bold', color: colors.text, fontSize: 14, marginBottom: 6 }}>Preferred Time Slot</Text>
                <TextInput 
                  style={[styles.input, { borderColor: colors.border, color: colors.text, backgroundColor: colors.card, marginBottom: 15 }]} 
                  placeholder="e.g. 11:30 AM" 
                  placeholderTextColor={colors.textMuted}
                  value={bookingTime}
                  onChangeText={setBookingTime}
                />
              </View>
            )}

            {/* Action Buttons */}
            {selectedShop?.shop_type === 'appointment' ? (
              <TouchableOpacity 
                onPress={() => {
                  if (!selectedStaffMember || !bookingDate || !bookingTime) {
                    Alert.alert('Validation Error', 'Please select a staff member, booking date, and time slot.');
                  } else {
                    setShowPaymentModal(true);
                  }
                }} 
                style={[styles.button, { backgroundColor: colors.primary }]}
              >
                <Text style={styles.buttonText}>Book Appointment (₹100 Booking Fee)</Text>
              </TouchableOpacity>
            ) : (
              getCartTotal() > 0 && (
                <TouchableOpacity onPress={() => setShowPaymentModal(true)} style={[styles.button, { backgroundColor: colors.primary }]}>
                  <Text style={styles.buttonText}>Checkout (Total: ₹{getCartTotal()})</Text>
                </TouchableOpacity>
              )
            )}
          </ScrollView>
        );

      case 'Wallet':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>👛 Local Wallet</Text>
            </View>

            <View style={{ backgroundColor: '#10b981', padding: 24, borderRadius: 16, marginBottom: 20 }}>
              <Text style={{ color: '#d1fae5', fontSize: 14 }}>Available Balance</Text>
              <Text style={{ color: '#fff', fontSize: 36, fontWeight: 'bold', marginVertical: 8 }}>₹{walletBalance.toFixed(2)}</Text>
            </View>

            <Text style={{ fontWeight: 'bold', color: colors.text, marginBottom: 10 }}>Transaction Ledger</Text>
            {walletTransactions.map(tx => (
              <View key={tx.id} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border, flexDirection: 'row', justifyContent: 'space-between' }]}>
                <Text style={{ color: colors.text }}>{tx.purpose}</Text>
                <Text style={{ fontWeight: 'bold', color: tx.type === 'credit' ? '#10b981' : colors.text }}>{tx.amount}</Text>
              </View>
            ))}
          </ScrollView>
        );

      case 'SocietyDetails':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🏘️ Society Gate Management</Text>
            </View>

            <View style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
              <Text style={{ fontWeight: 'bold', color: colors.text, marginBottom: 10 }}>Pre-Approve Visitor / Cab</Text>
              <TextInput style={[styles.input, { borderColor: colors.border, color: colors.text, marginBottom: 10 }]} placeholder="Visitor Name" placeholderTextColor={colors.textMuted} />
              <TextInput style={[styles.input, { borderColor: colors.border, color: colors.text, marginBottom: 10 }]} placeholder="Phone Number" placeholderTextColor={colors.textMuted} />
              <TouchableOpacity onPress={() => Alert.alert('Approved', 'Gate pass QR code generated successfully!')} style={[styles.button, { backgroundColor: colors.primary }]}>
                <Text style={styles.buttonText}>Generate Gate Pass</Text>
              </TouchableOpacity>
            </View>
          </ScrollView>
        );

      case 'Carpool':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🚗 Carpool Commuting</Text>
            </View>

            {carpoolRides.map(ride => (
              <View key={ride.id} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
                <Text style={{ color: colors.text, fontWeight: 'bold' }}>{ride.from} ➡️ {ride.to}</Text>
                <Text style={{ color: colors.textMuted }}>Driver: {ride.driver}</Text>
                <Text style={{ color: colors.primary, fontWeight: 'bold', marginTop: 5 }}>Rate: {ride.price}</Text>
              </View>
            ))}
          </ScrollView>
        );

      case 'Events':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🎫 Event Ticketing</Text>
            </View>
            <View style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
              <Text style={{ color: colors.text, fontWeight: 'bold' }}>Yoga & Mindfulness Workshop</Text>
              <Text style={{ color: colors.textMuted }}>Venue: Goodwill Clubhouse | Date: June 28</Text>
              <TouchableOpacity onPress={() => Alert.alert('Booked', 'Ticket booked successfully!')} style={[styles.button, { backgroundColor: colors.primary, marginTop: 10 }]}>
                <Text style={styles.buttonText}>Book Free RSVP Ticket</Text>
              </TouchableOpacity>
            </View>
          </ScrollView>
        );

      case 'Pets':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🐾 Pets & Lost Alerts</Text>
            </View>

            <Text style={{ color: 'red', fontWeight: 'bold', marginVertical: 10 }}>🚨 Active Alerts</Text>
            {petAlerts.map(alert => (
              <View key={alert.id} style={[styles.card, { backgroundColor: colors.card, borderColor: '#fca5a5', borderWidth: 1.5 }]}>
                <Text style={{ color: 'red', fontWeight: 'bold' }}>LOST: {alert.petName} ({alert.breed})</Text>
                <Text style={{ color: colors.textMuted }}>{alert.desc}</Text>
              </View>
            ))}
          </ScrollView>
        );

      case 'Health':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>❤️ Health & SOS Directory</Text>
            </View>

            <TouchableOpacity onPress={handleSOS} style={{ backgroundColor: '#ef4444', padding: 28, borderRadius: 999, alignItems: 'center', marginVertical: 20, width: 180, height: 180, alignSelf: 'center', justifyContent: 'center', shadowColor: '#ef4444', shadowOpacity: 0.5, shadowRadius: 20 }}>
              <Text style={{ fontSize: 36 }}>🚨</Text>
              <Text style={{ color: '#fff', fontSize: 18, fontWeight: 'bold', marginTop: 8 }}>TRIGGER SOS</Text>
            </TouchableOpacity>

            <Text style={{ color: colors.text, fontWeight: 'bold', marginBottom: 10 }}>🆘 Emergency Numbers</Text>
            {[
              { label: 'Medical Ambulance', num: '108', color: '#ef4444' },
              { label: 'Police', num: '100', color: '#4f46e5' },
              { label: 'Fire Brigade', num: '101', color: '#f97316' },
              { label: 'Women Helpline', num: '1091', color: '#8b5cf6' },
            ].map((ec, i) => (
              <View key={i} style={[styles.card, { backgroundColor: colors.card, borderColor: ec.color, borderLeftWidth: 4, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }]}>
                <Text style={{ color: colors.text }}>{ec.label}</Text>
                <Text style={{ color: ec.color, fontWeight: 'bold', fontSize: 20 }}>{ec.num}</Text>
              </View>
            ))}
          </ScrollView>
        );

      case 'Earn':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>💰 Earn Money Platform</Text>
            </View>

            {/* Earning Streams */}
            {[
              { icon: '🏍️', title: 'Delivery Runner', rate: '₹35–₹65/delivery', monthly: '~₹12,000–25,000/mo', color: '#10b981' },
              { icon: '🤝', title: 'Franchise Partner', rate: '30% of commission', monthly: '~₹40,000–1,20,000/mo', color: '#4f46e5' },
              { icon: '🏪', title: 'Shop Owner / Merchant', rate: '0% commission kept', monthly: 'Keep 100% revenue', color: '#f97316' },
              { icon: '💼', title: 'Sub-Agent (Referral)', rate: '₹50 per signup', monthly: 'Unlimited potential', color: '#8b5cf6' },
            ].map((stream, i) => (
              <View key={i} style={[styles.card, { backgroundColor: colors.card, borderColor: stream.color, borderLeftWidth: 4 }]}>
                <View style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 8 }}>
                  <Text style={{ fontSize: 28, marginRight: 10 }}>{stream.icon}</Text>
                  <View style={{ flex: 1 }}>
                    <Text style={{ color: colors.text, fontWeight: 'bold', fontSize: 15 }}>{stream.title}</Text>
                    <Text style={{ color: stream.color, fontWeight: 'bold', fontSize: 13 }}>{stream.rate}</Text>
                  </View>
                </View>
                <Text style={{ color: colors.textMuted, fontSize: 12, marginBottom: 10 }}>{stream.monthly}</Text>
                <TouchableOpacity onPress={() => Alert.alert('Applied!', `${stream.title} application submitted. Our team will contact you within 24 hours.`)} style={[styles.button, { backgroundColor: stream.color, height: 40 }]}>
                  <Text style={styles.buttonText}>Apply Now →</Text>
                </TouchableOpacity>
              </View>
            ))}
          </ScrollView>
        );

      case 'Marketplace':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🛍️ Buy & Sell Marketplace</Text>
            </View>
            {marketItems.map((item, i) => (
              <View key={i} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border, flexDirection: 'row', gap: 12, alignItems: 'center' }]}>
                <View style={{ flex: 1 }}>
                  <Text style={{ color: colors.text, fontWeight: 'bold' }}>{item.title}</Text>
                  <Text style={{ color: colors.textMuted, fontSize: 12 }}>Condition: {item.cond} · Seller: {item.seller}</Text>
                  <Text style={{ color: colors.primary, fontWeight: 'bold', marginTop: 4, fontSize: 16 }}>{item.price}</Text>
                </View>
                <TouchableOpacity onPress={() => Alert.alert('Chat', 'Opening in-app seller chat...')} style={{ backgroundColor: colors.primary, padding: 8, borderRadius: 8 }}>
                  <Text style={{ color: '#fff', fontSize: 12, fontWeight: 'bold' }}>Chat</Text>
                </TouchableOpacity>
              </View>
            ))}
          </ScrollView>
        );

      case 'Properties':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🏢 Real Estate Hub</Text>
            </View>
            {[
              { icon: '🏠', title: '2 BHK Flat — Pride Aashiyana', rent: '₹22,000/mo', type: 'Rent', zone: 'Dhanori', beds: '2 BHK' },
              { icon: '🏨', title: 'PG Room — Near Goodwill', rent: '₹6,500/mo', type: 'PG', zone: 'Dhanori', beds: 'Single Sharing' },
            ].map((prop, i) => (
              <View key={i} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
                <View style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 8 }}>
                  <Text style={{ fontSize: 28, marginRight: 10 }}>{prop.icon}</Text>
                  <View style={{ flex: 1 }}>
                    <Text style={{ color: colors.text, fontWeight: 'bold' }}>{prop.title}</Text>
                    <Text style={{ color: colors.textMuted, fontSize: 12 }}>{prop.beds} · 📍 {prop.zone}</Text>
                  </View>
                </View>
                <Text style={{ color: colors.primary, fontWeight: 'bold', fontSize: 18, marginBottom: 10 }}>{prop.rent}</Text>
                <TouchableOpacity onPress={() => Alert.alert('Enquiry Sent!', 'Direct enquiry sent to the landlord. No broker involved.')} style={[styles.button, { backgroundColor: colors.primary, height: 40 }]}>
                  <Text style={styles.buttonText}>Enquire — No Broker</Text>
                </TouchableOpacity>
              </View>
            ))}
          </ScrollView>
        );

      case 'Franchise':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <TouchableOpacity onPress={() => setCurrentScreen('Home')}>
                <Text style={{ color: colors.primary, fontWeight: 'bold' }}>⬅️ Back Home</Text>
              </TouchableOpacity>
              <Text style={[styles.headerTitle, { color: colors.text, marginTop: 10 }]}>🤝 Franchise Partner Portal</Text>
            </View>

            {/* If user is an Admin/Franchise, render the pending verification list! */}
            {['super_admin', 'territory_admin', 'area_agent', 'moderator'].includes(user?.role) ? (
              <View>
                <Text style={{ fontWeight: 'bold', color: colors.text, fontSize: 16, marginBottom: 12 }}>Pending Shop Approval Queue</Text>
                {pendingShops.length > 0 ? (
                  pendingShops.map(shop => (
                    <View key={shop.id} style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
                      <Text style={{ color: colors.text, fontWeight: 'bold', fontSize: 15 }}>{shop.name}</Text>
                      <Text style={{ color: colors.textMuted, fontSize: 12 }}>📍 {shop.address} | Category: {shop.category}</Text>
                      <Text style={{ color: colors.primary, fontSize: 11, marginVertical: 4 }}>Shop Type: {shop.shop_type}</Text>
                      
                      <View style={{ flexDirection: 'row', gap: 10, marginTop: 8 }}>
                        <TouchableOpacity 
                          onPress={() => handleApproveShop(shop.id, 'approved')} 
                          style={[styles.smallBtn, { backgroundColor: '#10b981' }]}
                        >
                          <Text style={{ color: '#fff', fontSize: 12, fontWeight: 'bold' }}>Approve</Text>
                        </TouchableOpacity>
                        <TouchableOpacity 
                          onPress={() => handleApproveShop(shop.id, 'rejected')} 
                          style={[styles.smallBtn, { backgroundColor: '#ef4444' }]}
                        >
                          <Text style={{ color: '#fff', fontSize: 12, fontWeight: 'bold' }}>Reject</Text>
                        </TouchableOpacity>
                      </View>
                    </View>
                  ))
                ) : (
                  <View style={{ padding: 30, alignItems: 'center' }}>
                    <Text style={{ color: colors.textMuted }}>No pending shop applications.</Text>
                  </View>
                )}
              </View>
            ) : (
              <View style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
                <Text style={{ color: colors.text, fontWeight: 'bold' }}>Apply for Pune Territory</Text>
                <Text style={{ color: colors.textMuted, marginVertical: 8 }}>Manage merchants, handle delivery agents, and receive 30% of platform commission.</Text>
                <TextInput style={[styles.input, { borderColor: colors.border, color: colors.text, marginBottom: 10 }]} placeholder="Desired Pincode (e.g. 411015)" placeholderTextColor={colors.textMuted} />
                <TouchableOpacity onPress={() => Alert.alert('Applied', 'Franchise territory request submitted!')} style={[styles.button, { backgroundColor: colors.primary }]}>
                  <Text style={styles.buttonText}>Submit Request</Text>
                </TouchableOpacity>
              </View>
            )}
          </ScrollView>
        );

      case 'Profile':
        return (
          <ScrollView style={[styles.scrollContainer, { backgroundColor: colors.bg }]}>
            <View style={styles.header}>
              <Text style={[styles.headerTitle, { color: colors.text }]}>👤 Resident Profile</Text>
            </View>

            <View style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border, alignItems: 'center' }]}>
              <View style={{ width: 60, height: 60, borderRadius: 30, backgroundColor: colors.primary, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ color: '#fff', fontSize: 24, fontWeight: 'bold' }}>JD</Text>
              </View>
              <Text style={{ color: colors.text, fontWeight: 'bold', fontSize: 18, marginTop: 10 }}>{user?.full_name || 'Guest User'}</Text>
              <Text style={{ color: colors.textMuted }}>Role: {user?.role || 'user'}</Text>
            </View>

            <View style={[styles.card, { backgroundColor: colors.card, borderColor: colors.border, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }]}>
              <Text style={{ color: colors.text, fontWeight: '600' }}>Dark Mode</Text>
              <Switch value={isDarkMode} onValueChange={setIsDarkMode} />
            </View>

            <TouchableOpacity 
              onPress={() => {
                setAuthToken(null);
                setUser(null);
                setCurrentScreen('Login');
              }} 
              style={[styles.button, { backgroundColor: '#ef4444', marginTop: 20 }]}
            >
              <Text style={styles.buttonText}>Logout</Text>
            </TouchableOpacity>
          </ScrollView>
        );
    }
  };

  return (
    <SafeAreaView style={[styles.container, { backgroundColor: colors.bg }]}>
      <StatusBar barStyle={isDarkMode ? 'light-content' : 'dark-content'} />
      {renderScreen()}

      {/* Unified Mobile Payment Modal */}
      {showPaymentModal && (
        <Modal transparent animationType="slide" visible={showPaymentModal}>
          <View style={styles.modalOverlay}>
            <View style={[styles.modalContent, { backgroundColor: colors.card }]}>
              <Text style={{ fontSize: 18, fontWeight: 'bold', color: colors.text, marginBottom: 15 }}>Complete Payment</Text>
              
              <Text style={{ fontSize: 12, color: colors.textMuted, marginBottom: 8 }}>SELECT PAYMENT METHOD</Text>
              
              <TouchableOpacity 
                onPress={() => setSelectedPaymentMethod('COD')}
                style={[styles.payOption, { borderColor: selectedPaymentMethod === 'COD' ? colors.primary : colors.border }]}
              >
                <Text style={{ color: colors.text, fontWeight: 'bold' }}>Pay at Shop / COD</Text>
              </TouchableOpacity>

              <TouchableOpacity 
                onPress={() => setSelectedPaymentMethod('WALLET')}
                style={[styles.payOption, { borderColor: selectedPaymentMethod === 'WALLET' ? colors.primary : colors.border }]}
              >
                <Text style={{ color: colors.text, fontWeight: 'bold' }}>Local Wallet (Balance: ₹{walletBalance})</Text>
              </TouchableOpacity>

              <TouchableOpacity 
                onPress={() => setSelectedPaymentMethod('RAZORPAY')}
                style={[styles.payOption, { borderColor: selectedPaymentMethod === 'RAZORPAY' ? colors.primary : colors.border }]}
              >
                <Text style={{ color: colors.text, fontWeight: 'bold' }}>Online Gateway via Razorpay (UPI)</Text>
              </TouchableOpacity>

              <View style={{ flexDirection: 'row', gap: 10, marginTop: 20 }}>
                <TouchableOpacity onPress={() => setShowPaymentModal(false)} style={[styles.button, { flex: 1, backgroundColor: '#94a3b8' }]}>
                  <Text style={styles.buttonText}>Cancel</Text>
                </TouchableOpacity>
                <TouchableOpacity onPress={processPlatformPayment} style={[styles.button, { flex: 1, backgroundColor: colors.primary }]}>
                  <Text style={styles.buttonText}>Confirm</Text>
                </TouchableOpacity>
              </View>
            </View>
          </View>
        </Modal>
      )}

      {/* Bottom Tab Bar Switcher — 5 tabs */}
      {currentScreen !== 'Login' && currentScreen !== 'OTP' && (
        <View style={[styles.navBar, { backgroundColor: colors.card, borderTopColor: colors.border }]}>
          {[
            { screen: 'Home', icon: '🏠', label: 'Home' },
            { screen: 'Shops', icon: '🏪', label: 'Shops' },
            { screen: 'Earn', icon: '💰', label: 'Earn' },
            { screen: 'Wallet', icon: '👛', label: 'Wallet' },
            { screen: 'Profile', icon: '👤', label: 'Profile' },
          ].map((tab, i) => {
            const isActive = currentScreen === tab.screen;
            return (
              <TouchableOpacity key={i} onPress={() => {
                if (tab.screen === 'Shops') { fetchShops(); }
                setCurrentScreen(tab.screen);
              }} style={[styles.navItem, isActive && { backgroundColor: colors.primaryLight, borderRadius: 8, paddingVertical: 4, paddingHorizontal: 8 }]}>
                <Text style={{ fontSize: 20 }}>{tab.icon}</Text>
                <Text style={{ color: isActive ? colors.primary : colors.textMuted, fontSize: 10, fontWeight: isActive ? 'bold' : 'normal' }}>{tab.label}</Text>
              </TouchableOpacity>
            );
          })}
        </View>
      )}
    </SafeAreaView>
  );
}

